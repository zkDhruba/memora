{
  "name": "memora",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "pnpm build && pnpm typecheck",
    "build:packages": "turbo run build --filter=@memora/shared --filter=@memora/db",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "deps:up": "docker compose -f infra/docker-compose.yml up -d",
    "deps:down": "docker compose -f infra/docker-compose.yml down",
    "deps:ps": "docker compose -f infra/docker-compose.yml ps",
    "deps:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "deps:reset": "docker compose -f infra/docker-compose.yml down -v",
    "db:generate": "pnpm --filter @memora/db generate",
    "db:migrate": "pnpm --filter @memora/db migrate",
    "db:seed": "pnpm --filter @memora/db seed"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.9.2"
  }
}
