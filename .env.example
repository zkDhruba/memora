# Copy to .env for local development. Never commit .env.

WEB_ORIGIN=http://localhost:3000
API_PORT=4000

# Postgres (infra/docker-compose.yml)
DATABASE_URL=postgresql://memora:memora@localhost:5432/memora

# Redis
REDIS_URL=redis://localhost:6379

# Object store — S3 API (local: pgsty/silo in Compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=memora
S3_SECRET_KEY=memoradevpass
S3_BUCKET_QUARANTINE=memora-quarantine
S3_BUCKET_CLEAN=memora-clean
S3_FORCE_PATH_STYLE=true

# Mailpit SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@memora.local
MAILPIT_UI=http://localhost:8025

# ClamAV
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# App secrets (generate real values before Phase 1.4+)
# COOKIE_SECRET=
# APP_DATA_KEY=
